# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Wrap values containing "$" in single quotes.

# --- Server (all optional) ---
# Port the API listens on. Default: 8080
PORT=8080
# Public URL that short codes are appended to. Default: http://localhost:<PORT>/
BASE_URL=http://localhost:8080/
# Gin mode: debug | release | test. Default: release
# (use APP_MODE, not GIN_MODE: gin panics on a bad GIN_MODE before config is validated)
APP_MODE=debug

# --- Database ---
DB_USER=urlshortener
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=main
# disable | allow | prefer | require | verify-ca | verify-full. Default: disable
DB_SSLMODE=disable
