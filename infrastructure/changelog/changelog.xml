<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">
    <changeSet id="001" author="your_name">
        <sqlFile path="./liquibase/changelog/sql/001_create_urls_table.sql"/>
    </changeSet>
    <changeSet id="002" author="dhiren">
        <sqlFile path="./liquibase/changelog/sql/002_rename_counter_to_click_count.sql"/>
    </changeSet>
    <changeSet id="003" author="dhiren">
        <sqlFile path="./liquibase/changelog/sql/003_unique_short_url_and_created_at.sql"/>
    </changeSet>
    <changeSet id="004" author="dhiren">
        <preConditions onFail="HALT"
                       onFailMessage="URLS has rows sharing md5(LONG_URL) (the same URL under different codes, or an md5 collision). Each of their codes may be published, so resolve them by hand before running this migration.">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM (SELECT 1 FROM URLS GROUP BY md5(LONG_URL) HAVING COUNT(*) &gt; 1) d
            </sqlCheck>
        </preConditions>
        <sqlFile path="./liquibase/changelog/sql/004_unique_long_url_md5.sql"/>
        <rollback>
            DROP INDEX ux_urls_long_url_md5;
        </rollback>
    </changeSet>
</databaseChangeLog>
